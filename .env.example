# image-gen environment variables
# Copy to .env and fill in values before running locally.
# One API key per provider; at least the default provider's key is required.
# All variables use the IMAGEGEN_ prefix (read by pydantic-settings).

# ── Providers ──────────────────────────────────────────────────────────────
# Google Gemini (default provider)
IMAGEGEN_GOOGLE_API_KEY=

# OpenAI (gpt-image-2) — required when IMAGEGEN_DEFAULT_PROVIDER=openai
IMAGEGEN_OPENAI_API_KEY=

# OpenRouter — required when IMAGEGEN_DEFAULT_PROVIDER=openrouter
IMAGEGEN_OPENROUTER_API_KEY=

# Local ComfyUI — generates on-device (zero API cost). Set the URL to register the
# provider; leave it UNSET (e.g. in the homelab container) to keep it out of the
# registry. localhost only — see docs/how-to-local-comfyui.md and ADR 0004.
# IMAGEGEN_COMFYUI_URL=http://127.0.0.1:8188
# IMAGEGEN_COMFYUI_MODEL=flux1-schnell
# IMAGEGEN_COMFYUI_STEPS=4
# Override the bundled API-format workflow template (defaults to the shipped FLUX schnell):
# IMAGEGEN_COMFYUI_WORKFLOW=/path/to/your/flux_workflow_api.json

# Which provider to use when none is specified per request (gemini | openai | openrouter | comfyui)
IMAGEGEN_DEFAULT_PROVIDER=gemini

# Per-request timeout in seconds for provider API calls
IMAGEGEN_REQUEST_TIMEOUT_SECONDS=120.0

# ── Server ─────────────────────────────────────────────────────────────────
IMAGEGEN_PORT=8000

# ── Storage ────────────────────────────────────────────────────────────────
# Base directory where images and the database are stored
IMAGEGEN_DATA_DIR=/app/data

# Override the SQLite database path (defaults to {data_dir}/image-gen.db)
# IMAGEGEN_DB_PATH=/app/data/image-gen.db

# ── Authentication ─────────────────────────────────────────────────────────
IMAGEGEN_AUTH_ENABLED=true

# OIDC issuer URL (must match the JWT iss claim)
IMAGEGEN_OIDC_ISSUER=https://auth.sjo.lol

# OIDC client ID (must match the JWT aud claim)
IMAGEGEN_OIDC_CLIENT_ID=image-gen

# ── Quota (token-bucket rate limiting) ─────────────────────────────────────
# Maximum burst tokens per user
IMAGEGEN_QUOTA_MAX_TOKENS=10

# Token refill rate per second (~2/min default)
IMAGEGEN_QUOTA_REFILL_RATE=0.033

# ── Logging ────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
IMAGEGEN_LOG_LEVEL=INFO
